# EXAMPLE / TEMPLATE — fill in your own region(s), AWS account id(s) and ACM
# certificate ARN(s). The aws:elbv2:listener:443 block below resolves the cert
# for the running environment via Fn::FindInMap on { region, accountId }, so
# each region/account you deploy to needs a matching entry here.
Mappings:
  SSLCertificate:
    <your-region>:
      <your-aws-account-id>: arn:aws:acm:<your-region>:<your-aws-account-id>:certificate/<your-certificate-id>

option_settings:
  aws:elasticbeanstalk:command:
    DeploymentPolicy: Immutable
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /health
  aws:elasticbeanstalk:application:environment:
    DS_HOST: changeme
    DS_PORT: 5432
    DS_DB_NAME: changeme
    DS_USERNAME: changeme
    DS_PASSWORD: changeme
    JURALIO_S3_BUCKET: changeme
    AWS_SDK_REGION: eu-west-2
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /health
  aws:autoscaling:asg:
    MinSize: 1
    MaxSize: 5
  aws:autoscaling:launchconfiguration:
    SSHSourceRestriction: 'tcp, 22, 22, YOUR_ADMIN_IP/32'
  aws:elasticbeanstalk:environment:
    LoadBalancerType: application
  aws:elbv2:listener:443:
    ListenerEnabled: 'true'
    SSLCertificateArns: { "Fn::FindInMap" : [ "SSLCertificate", { "Ref" : "AWS::Region" }, { "Ref" : "AWS::AccountId" }]}
    Protocol: HTTPS
    SSLPolicy: ELBSecurityPolicy-FS-1-2-2019-08
  aws:elasticbeanstalk:managedactions:platformupdate:
    UpdateLevel: minor
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: apache
  aws:elasticbeanstalk:managedactions:
    ManagedActionsEnabled: true
    PreferredStartTime: "Sun:01:00"
    ServiceRoleForManagedUpdates: AWSServiceRoleForElasticBeanstalkManagedUpdates

Resources:
  HighCPUAlarmSNSTopic:
    Type: AWS::SNS::Topic
    Properties:
      Subscription:
        - Endpoint: developers@example.com
          Protocol: email
      TopicName: { "Fn::Join" : ["", [{ "Ref" : "AWSEBEnvironmentName" }, "-HighCPUAlarmSNSTopic" ]]}
  AWSEBCloudwatchAlarmHigh:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmActions: []
  AWSEBCloudwatchAlarmLow:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmActions: []
  # Create custom policies
  AutoScalingCustomScaleDownPolicy:
    Type: AWS::AutoScaling::ScalingPolicy
    Properties:
      AdjustmentType: ChangeInCapacity
      AutoScalingGroupName: {Ref: AWSEBAutoScalingGroup}
      ScalingAdjustment: -1
  AutoScalingCustomScaleUpPolicy:
    Type: AWS::AutoScaling::ScalingPolicy
    Properties:
      AdjustmentType: ChangeInCapacity
      AutoScalingGroupName: {Ref: AWSEBAutoScalingGroup}
      ScalingAdjustment: 1
  # Alarms for memory usage
  CustomScalingAlarmHigh:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmActions:
        - {Ref: AWSEBAutoScalingScaleUpPolicy}
        - {Ref: HighCPUAlarmSNSTopic}
      AlarmDescription: { "Fn::Join" : ["", [{ "Ref" : "AWSEBEnvironmentName" }, ": alarm if memory usage is more than 70% for 60 seconds" ]]}
      ComparisonOperator: GreaterThanThreshold
      Dimensions:
        - Name: AutoScalingGroupName
          Value: {Ref: AWSEBAutoScalingGroup}
      Statistic: Average
      Period: 60 # Seconds
      EvaluationPeriods: 1
      MetricName: mem_used_percent
      Namespace: CWAgent
      Threshold: 70
  CustomScalingAlarmLow:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmActions:
        - {Ref: AWSEBAutoScalingScaleDownPolicy}
      AlarmDescription: { "Fn::Join" : ["", [{ "Ref" : "AWSEBEnvironmentName" }, ": alarm if memory usage is less than 40% for 60 seconds" ]]}
      ComparisonOperator: LessThanThreshold
      Dimensions:
        - Name: AutoScalingGroupName
          Value: {Ref: AWSEBAutoScalingGroup}
      Period: 60 # Seconds
      Statistic: Average
      EvaluationPeriods: 1
      MetricName: mem_used_percent
      Namespace: CWAgent
      Threshold: 40