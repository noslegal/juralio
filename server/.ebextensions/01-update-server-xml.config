files:
  "/tmp/update_server_xml.sh":
    owner: root
    group: root
    mode: "000755"
    content: |
      #! /bin/bash
      TOMCAT_PATH_FOR_SCRIPT="/etc/tomcat8/server.xml"
      release=$(cat /etc/system-release)
      if [[ $release == *"Amazon Linux release 2"* ]]; then
        TOMCAT_PATH_FOR_SCRIPT="/etc/tomcat/server.xml"
      fi

      CONFIGURED=`grep -c 'server="Juralio"' $TOMCAT_PATH_FOR_SCRIPT`
      if [ "$CONFIGURED" = "0" ]
        then
          sed -i 's/<Connector port="8080" protocol="HTTP\/1.1"/\<Connector port="8080" protocol="HTTP\/1.1" maxHttpHeaderSize="10000" server="Juralio"/' $TOMCAT_PATH_FOR_SCRIPT
          logger -t tomcat_conf "$TOMCAT_PATH_FOR_SCRIPT updated successfully"
          echo "$TOMCAT_PATH_FOR_SCRIPT updated successfully"
          exit 0
        else
          logger -t tomcat_conf "$TOMCAT_PATH_FOR_SCRIPT already updated"
          echo "$TOMCAT_PATH_FOR_SCRIPT updated successfully"
          exit 0
      fi

container_commands:
  01-update-server-xml:
    command: sh /tmp/update_server_xml.sh