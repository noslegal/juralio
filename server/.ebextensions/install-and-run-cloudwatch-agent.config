files:
  "/tmp/install_and_run_cloudwatch_agent.sh":
    owner: root
    group: root
    mode: "000755"
    content: |
      #! /bin/bash

      # Install v2 of the AWS CLI
      curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
      unzip -o awscliv2.zip
      sudo ./aws/install

      # Install jq
      sudo yum install -y jq

      # Install CloudWatch agent
      release=$(cat /etc/system-release)
      if [[ $release == *"Amazon Linux release 2"* ]]; then
        logger -t tomcat_conf "Using Amazon Linux 2"
        wget https://s3.eu-west-2.amazonaws.com/amazoncloudwatch-agent-eu-west-2/amazon_linux/amd64/latest/amazon-cloudwatch-agent.rpm
      else
        logger -t tomcat_conf "Using Amazon Linux 1"
        wget https://s3.amazonaws.com/amazoncloudwatch-agent/amazon_linux/amd64/latest/amazon-cloudwatch-agent.rpm
      fi

      yum install -y amazon-cloudwatch-agent.rpm

      # Set up config for agent
      CONFIG_PATH=/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
      mkdir -p {/usr/share/collectd/,/opt/aws/amazon-cloudwatch-agent/etc/}
      touch {/usr/share/collectd/types.db,$CONFIG_PATH}
      # This is readable if you copy/paste the json into a file with .json extension
      json='{"agent":{"metrics_collection_interval":60,"run_as_user":"root"},"metrics":{"namespace":"CWAgent","append_dimensions":{"AutoScalingGroupName":"${aws:AutoScalingGroupName}"},"metrics_collected":{"mem":{"measurement":[{"name":"mem_used_percent","rename":"mem_used_percent","unit":"Percent"}],"metrics_collection_interval":60}}},"aggregation_dimensions":[["AutoScalingGroupName"]]}'
      echo $json > $CONFIG_PATH

      # Run CloudWatch agent
      sudo /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s -c file:$CONFIG_PATH
      /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -m ec2 -a status

container_commands:
  install-and-run-cloudwatch-agent:
    command: sh /tmp/install_and_run_cloudwatch_agent.sh
