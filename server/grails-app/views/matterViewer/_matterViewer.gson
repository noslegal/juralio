import com.juralio.matter.MatterViewer

model {
    MatterViewer matterViewer
}

json g.render(matterViewer, [excludes: ["user"]]) {
    user tmpl.'/appUser/appUser'(appUser: matterViewer.user)
    if (matterViewer.user.organisationGroup) {
        organisationGroup {
            id matterViewer.user.organisationGroup.id
            name matterViewer.user.organisationGroup.name
            isInternal matterViewer.user.organisationGroup.isInternal
            customLogo matterViewer.user.organisationGroup.logo != null
            organisationId matterViewer.user.organisationGroup.organisation?.id
        }
    }
}