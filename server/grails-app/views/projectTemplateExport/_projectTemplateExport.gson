import com.juralio.auth.AppUser
import com.juralio.matter.Matter
import com.juralio.post.Post
import com.juralio.project.Project
import com.juralio.template.ProjectTemplate
import com.juralio.template.TaskTemplate
import com.juralio.templateResource.TemplateResource

model {
    ProjectTemplate projectTemplate
}


static def renderPosts(List<Post> posts) {
    return posts.collect {
        [
                id         : 'CT' + it.id,
                name       : it.name,
                type       : it.type,
                url        : it.url,
                description: it.description,
                startTime  : it.startTime,
                endTime    : it.endTime,
                finalised  : it.finalised,
                privatePost: it.privatePost
        ]
    }
}

def renderTasks(List<TaskTemplate> tasks) {
    if (tasks) {
        return tasks.collect {
            [
                    id           : 'CT' + it.id,
                    name         : it.name,
                    level        : it.level,
                    isMilestone  : it.isMilestone,
                    isDeliverable: it.isDeliverable,
                    tasks        : renderTasks(it.tasks),
                    posts        : renderPosts(it.posts as List<Post>),
                    description  : it.noticeboardText
            ]
        }
    }
    return []
}

static def renderResources(List<TemplateResource> resources) {
    return resources.collect {
        [
                name : it.name,
                url  : it.url,
                image: it.image
        ]
    }
}

json g.render(projectTemplate, [excludes: ['tasks', 'systemTemplateUpdateCount', 'referenceNumber', 'taskCount', 'levelATaskCount', 'lastUpdated', 'dateCreated', 'id', 'organisation', 'referenceNumber', 'isSystemTemplate', 'url', 'urlCredit', 'urlCreditName', 'companyImage', 'companyImageBackground']]) {
    tasks renderTasks(projectTemplate.levelATasks)
    resources renderResources(projectTemplate.resources)
    metadata projectTemplate.metadata

}