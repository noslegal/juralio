import com.juralio.task.TaskBlocker

model {
    List<TaskBlocker> taskBlockerList
}
getBinding().variables.each { k, v ->
    System.out.println "${k} = ${v}"
}
json g.render(template: "taskBlocker", collection: taskBlockerList)