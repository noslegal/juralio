import com.juralio.task.Task
import com.juralio.task.TaskBlocker
import com.juralio.task.label.TaskLabel
import com.juralio.task.status.TaskStatus

/**
 * The purpose of this view is to render a single task and its direct sub-tasks
 */
model {
    TaskBlocker taskBlocker
}


def renderBlocker(TaskBlocker blocker){
    return [
            id:  blocker.id,
            blocker: [id: blocker.blocker.id, name:blocker.blocker.name, level:blocker.blocker.level,status:blocker.blocker.status],
            blocked: [id: blocker.blocked.id, name:blocker.blocked.name, level:blocker.blocked.level,status:blocker.blocked.status],
            relationship: blocker.relationship
    ]
}

json g.render(renderBlocker(taskBlocker)) {}
