import com.juralio.task.Task

model {
    Task task
}

json {
    tasks g.render(task.tasks)
    id task.id
    name task.name
    level task.level
    status task.status
    referenceNumber task.referenceNumber
    projectId task.project.id
    projectName task.project.name
    matterId task.project.matter.id
    archivedDate task.archivedDate
    archivedByName task.archivedBy.firstname + ' ' + task.archivedBy.lastname
    archivedById task.archivedBy.id
    restoreToProjectName task.restoreToProjectName
    restoreToProjectId task.restoreToProjectId
    restoreToParentName task.restoreToParentName
    isMilestone task.isMilestone
    isDeliverable task.isDeliverable
    postCount task.posts.size()
}