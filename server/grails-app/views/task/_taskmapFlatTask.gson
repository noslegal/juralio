import com.juralio.task.Task
import com.juralio.task.follower.TaskFollower
import com.juralio.task.label.TaskLabel
import com.juralio.task.team.TaskTeamMember
import com.juralio.organisationgroup.OrganisationGroup

/**
 * The purpose of this view is to render a single task and its direct sub-tasks
 */
model {
    Task task
}

def renderLabels(List<TaskLabel> labels) {
    labels.collect {
        [
                name    : it.label.name,
                type    : it.label.type,
                modifier: it.modifier,
                id      : it.id,
                labelId : it.label.id,
                inactive: it.label.inactive
        ]

    }
}

def renderTasks(List<Task> tasks){
    tasks.collect{[id:it.id,tasks:renderTasks(it.tasks)]}
}

def renderFollowers(List<TaskFollower> followers) {
    followers.collect { follower ->
        [id       : follower.user.id,
         firstname: follower.user.firstname,
         lastname : follower.user.lastname,
         email    : follower.user.username,
         enabled  : follower.user.enabled]
    }
}

def renderTeamMembers(List<TaskTeamMember>taskTeamMembers){
    taskTeamMembers.collect { taskMember ->
        [id              : taskMember.user ? taskMember.user.id : taskMember.placeholder.id,
         firstname       : taskMember.user ? taskMember.user.firstname : taskMember.placeholder.firstName,
         lastname        : taskMember.user ? taskMember.user.lastname : taskMember.placeholder.lastName,
         avatarColorIndex: taskMember.user ? taskMember.user.avatarColorIndex : '',
         avatarImageIndex: taskMember.user ? taskMember.user.avatarImageIndex : '',
         email           : taskMember.user ? taskMember.user.username : taskMember.placeholder.emailAddress,
         enabled         : taskMember.user ? taskMember.user.enabled : taskMember.placeholder.enabled,
         isExternal      : taskMember.user ? taskMember.user.externalUser != null : false,
         isOnAllSubtasks : taskMember.user ? taskMember.user.isOnAllSubtasks : false,
         isPlaceholder   : taskMember.placeholder ? true : false,
         organisationGroup: taskMember.user ? renderOrganisationGroup(taskMember.user.organisationGroup) : null
        ]
    }
}

def renderOrganisationGroup(OrganisationGroup orgGroup){
return  orgGroup ? [id:orgGroup.id,name:orgGroup.name,isInternal:orgGroup.isInternal,customLogo:orgGroup.logo != null,organisationId:orgGroup.organisation?.id] : null
}




json g.render(task, [excludes: ['createdBy', 'dateCreated', 'isParked', 'projectTemplate', 'taskParentWhenArchived']]) {
    tasks renderTasks(task.tasks)
    plannedStartDate task.plannedStartDate
    plannedEndDate task.plannedEndDate
    actualStartDate task.actualStartDate
    actualEndDate task.actualEndDate
    teamMembers renderTeamMembers(task.teamMembers as List<TaskTeamMember>)
    followers task.followers ? renderFollowers(task.followers as List<TaskFollower>) : []
    projectId task.project.id
    matterId task.project.matter.id
    activities task.activities
    isFollower task.isCurrentUserFollower
    isMilestone task.isMilestone
    isDeliverable task.isDeliverable
    isBlocked task.isBlocked
    isBlocker task.isBlocker
    updateMeta task.updateMeta
    parent task.parent
    labels task.labels ? renderLabels(task.labels as List<TaskLabel>) : null
    listIdx task.listIdx
}
