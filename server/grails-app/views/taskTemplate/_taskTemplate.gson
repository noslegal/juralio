import com.juralio.template.TaskTemplate

/**
 * The purpose of this view is to render only the top level task template properties and direct sub-tasks
 */
model {
    TaskTemplate taskTemplate
}

json g.render(taskTemplate, [excludes: ['projectTemplate']]) {
    parent g.render(taskTemplate.parent)
    tasks renderTasks(taskTemplate.tasks)
    posts g.render(taskTemplate.posts)
    noticeboardText taskTemplate.noticeboardText
    projectTemplateId renderTemplateId(taskTemplate)
}

def renderTasks(List<TaskTemplate> tasks) {
    if (tasks) {
        return tasks.collect {
            [id             : it.id,
             referenceNumber: it.referenceNumber,
             name           : it.name,
             level          : it.level,
             isMilestone    : it.isMilestone,
             isDeliverable  : it.isDeliverable,
             parent         : renderParent(it.parent),
             tasks          : renderTasksShort(it.tasks)
            ]
        }
    }
    return []
}

def renderParent(TaskTemplate parentTask) {
    if (!parentTask) return []
    return [
            id   : parentTask.id,
            tasks: renderTasksShort(parentTask.tasks)
    ]
}

def renderTasksShort(List<TaskTemplate> tasks) {
    if (!tasks) return []
    return tasks.collect { [id: it.id] }
}

def renderTemplateId(TaskTemplate task){
    return  task.projectTemplateId
}