import com.juralio.post.Post
import com.juralio.template.TaskTemplate

/**
 * The purpose of this view is to render a list of template tasks and their entire sub-task hierarchy
 */
model {
    List<TaskTemplate> taskTemplateList
}

def renderParent(TaskTemplate parentTask) {
    if (!parentTask) return []
    return [
            id   : parentTask.id,
    ]
}

def renderTasks(List<TaskTemplate> tasks) {
    if (tasks) {
        return tasks.collect {
            [id             : it.id,
             referenceNumber: it.referenceNumber,
             name           : it.name,
             level          : it.level,
             isMilestone    : it.isMilestone,
             isDeliverable  : it.isDeliverable,
             parent         : renderParent(it.parent),
             tasks          : renderTasks(it.tasks),
             posts          : renderPosts(it.posts),
             childCount     : it.tasks.size(),
             listIdx        : it.listIdx
            ]
        }
    }
    return []

}

def renderPosts(Set<Post> posts) {
    return posts.collect {
        [
                id  : it.id,
                name: it.name,
                finalised: it.finalised
        ]
    }
}

json g.render(renderTasks(taskTemplateList))