import com.juralio.auth.AppUser
import com.juralio.matter.Matter
import com.juralio.matter.MatterTeamMember
import com.juralio.project.Project
import com.juralio.task.Task
import com.juralio.task.team.TaskTeamMember

model {
    Matter matter
}

def renderTasks(List<Task> tasks) {
    tasks.collect {
        [id                   : it.id,
         referenceNumber      : it.referenceNumber,
         name                 : it.name,
         status               : it.status,
         level                : it.level,
         plannedStartDate     : it.plannedStartDate,
         plannedEndDate       : it.plannedEndDate,
         actualStartDate      : it.actualStartDate,
         actualEndDate        : it.actualEndDate,
         datesLinkedToSiblings: it.datesLinkedToSiblings,
         tasks                : renderTasks(it.tasks),
         childCount           : it.tasks.size(),
         teamMembers          : it.teamMembers.collect { taskMember ->
             [id              : taskMember.user ? taskMember.user.id : taskMember.placeholder.id,
              firstname       : taskMember.user ? taskMember.user.firstname : taskMember.placeholder.firstName,
              lastname        : taskMember.user ? taskMember.user.lastname : taskMember.placeholder.lastName,
              avatarColorIndex: taskMember.user ? taskMember.user.avatarColorIndex : '',
              avatarImageIndex: taskMember.user ? taskMember.user.avatarImageIndex : '',
              email           : taskMember.user ? taskMember.user.username : taskMember.placeholder.emailAddress,
              enabled         : taskMember.user ? taskMember.user.enabled : taskMember.placeholder.enabled,
              isPlaceholder   : taskMember.placeholder ? true : false]
         },
         followers            : it.followers.collect { follower ->
             [id       : follower.user.id,
              firstname: follower.user.firstname,
              lastname : follower.user.lastname,
              email    : follower.user.username,
              enabled  : follower.user.enabled]
         }
        ]
    }.sort { a, b -> a.status <=> b.status }
}

def getPostCount(List<Task> tasks) {
    tasks.collect { it.posts.size() }.sum() ?: 0
}

def getPeopleCount(List<Task> tasks) {
    List<TaskTeamMember> lttm = []
    tasks.collect { t -> t.teamMembers }.each { lttm.addAll(it) }
    List<AppUser> users = lttm.collect { TaskTeamMember ttm -> { if (ttm.user) { return ttm.user } } }
    return users.toSet().findAll { t -> t && t.enabled }.size()
}

def renderProjects(Set<Project> projects) {
    projects.collect {
        [
                taskCounts     : it.taskCounts,
                postCount     : it.postCount,
                peopleCount    : getPeopleCount(it.tasks),
                id             : it.id,
                name           : it.name,
                referenceNumber: it.referenceNumber,
                isPrivate      : it.isPrivate,
                isPrivateMember: it.isPrivateMember,
                active         : it.active

        ]
    }
}

def renderPostCount(List<Project> projects) {
    Long postCount = 0
    Map<String, Long> taskCounts = new HashMap<>()
    projects.each { Project p ->
        if (p.postCount) {
            postCount = postCount + p.postCount
        }
    }
    return postCount
}

def renderPhaseCount(List<Project> projects) {
    def phaseCount = 0
    for(var i=0;i<projects.size();i++){
        for(var j=0;j<projects[i].tasks.size();j++){
            Task task = projects[i].tasks[j]
            if(task.level == 1 as short) {
                phaseCount = phaseCount + 1
            }
        }
      }
    return phaseCount
}

def renderTeamMembers(List<MatterTeamMember> mtms) {
    return mtms.collect { taskMember ->
        [id              : taskMember.user.id,
         firstname       : taskMember.user.firstname,
         lastname        : taskMember.user.lastname,
         avatarColorIndex: taskMember.user.avatarColorIndex,
         avatarImageIndex: taskMember.user.avatarImageIndex,
         email           : taskMember.user.username,
         enabled         : taskMember.user.enabled]
    }
}
def renderPositionsOfGroups(List<MatterGroupPositionDTO> positionsOfGroups){
return positionsOfGroups.collect{[
    group: renderGroup(it.group),
    position: renderPosition(it.position)
    ]}
}

def renderGroup(OrganisationGroup group){
    return [
    id:      group.id,
    name:    group.name,
    isInternal: group.isInternal,
    customLogo: group.logo != null,
    organisationId: group.organisation?.id,
    ]
}

def renderPosition(GroupPosition position){
    return [
    id:     position.id,
    name:   position.name,
    ]
}



json g.render(matter, [excludes: ['deletedMirror', 'caseId']]) {
    activities matter.activities
    matterId matter.caseId
    projects renderProjects(matter.projects)
    viewers matter.matterViewers ? matter.matterViewers.findAll { user -> user.user.enabled }.size() : null
    admins matter.matterAdmins ? matter.matterAdmins.findAll { user -> user.user.enabled }.size() : null
    team matter.teamMembers ? matter.teamMembers.findAll { user -> user.user.enabled }.size() : null
    numProjects matter.projects ? matter.projects.size() : null
    teamMembers matter.teamMembers ? renderTeamMembers(matter.teamMembers as List) : []
    activeWorkstreams matter.projects ? matter.projects.findAll { project -> project.active }.size() : null
    postCount matter.projects ? renderPostCount(matter.projects as List<Project>) : null
    phaseCount matter.projects ? renderPhaseCount(matter.projects as List<Project>) : null
    positionsOfGroups matter.positionsOfGroups ? renderPositionsOfGroups(matter.positionsOfGroups) : null
}
