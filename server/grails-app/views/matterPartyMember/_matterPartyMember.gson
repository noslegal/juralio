import com.juralio.matter.MatterPartyMember

model {
    MatterPartyMember matterPartyMember
}

def renderMember(MatterPartyMember it) {
    def b = [
            id              : it.user.id,
            firstname       : it.user.firstname,
            lastname        : it.user.lastname,
            username        : it.user.username,
            isExternal      : it.user.externalUser != null,
            enabled         : it.user.enabled,
            isActiveOnMatter: it.user.isActiveOnMatter,
            isThirdPartyUser: it.user.isThirdPartyUser,
    ]
    def a = [
            memberId     : it.id,
            user         : b,
            matterParty  : it.matterParty.id,
            matterAdminId: it.matterAdminId,
            teamMemberId : it.teamMemberId,
    ]
    return a
}

json g.render(matterPartyMember, [excludes: ["user"]]) {
    member renderMember(matterPartyMember)
}