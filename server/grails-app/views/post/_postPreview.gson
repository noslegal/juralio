import com.juralio.post.Post
import com.juralio.post.authors.PostAuthor

model {
    Post post
}

def renderAuthors(def authors) {
    if (authors) {
        def out = []
        authors.each { it ->
            PostAuthor ttm = it as PostAuthor
            out.push([id: ttm.user.id, firstname: ttm.user.firstname, lastname: ttm.user.lastname, username: ttm.user.username])
        }
        return out
    }
    return []
}

json g.render(post, [excludes: ['description']]) {
    creator g.render(post.creator)
    authors renderAuthors(post.authors)
}