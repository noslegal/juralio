import com.juralio.template.ProjectTemplate
import com.juralio.template.TaskTemplate

model {
    ProjectTemplate projectTemplate
}

def renderTasks(List<TaskTemplate> tasks) {
    if (tasks) {
        return tasks.collect {
            [id             : it.id,
             referenceNumber: it.referenceNumber,
             name           : it.name,
             level          : it.level,
             isMilestone    : it.isMilestone,
             isDeliverable  : it.isDeliverable,
             tasks          : renderTasks(it.tasks)]
        }
    }
    return []

}

json g.render(projectTemplate) {
    taskCount projectTemplate.tasks ? projectTemplate.tasks.size() : 0
    isFavourited projectTemplate.isFavourited
    postCount projectTemplate.postCount
    publishedPostCount projectTemplate.publishedPostCount
    if (projectTemplate.levelATasks) {
        levelATaskCount projectTemplate.levelATasks.size()
        tasks renderTasks(projectTemplate.levelATasks)
    } else {
        tasks renderTasks(projectTemplate.tasks)
    }
}