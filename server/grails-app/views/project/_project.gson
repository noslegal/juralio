import com.juralio.project.Project
import server.PrivateWorkstreamMember

model {
    Project project
}

def renderPrivateWorkstreamTeam(Project project) {
    if (project.isPrivate) {
        project.privateWorkstreamTeam.collect { PrivateWorkstreamMember member ->
            def mem = [
                    id            : member.id,
                    user          : [
                            id                       : member.user.id,
                            username                 : member.user.username,
                            firstname                : member.user.firstname,
                            lastname                 : member.user.lastname,
                            avatarColorIndex         : member.user.avatarColorIndex,
                            avatarImageIndex         : member.user.avatarImageIndex,
                            enabled                  : member.user.enabled,
                            isActiveOnMatter         : member.matterAdmin || member.matterTeamMember || member.matterViewer,
                            privateWorkstreamMemberId: member.id
                    ],
                    matterViewerId: member.matterViewer,
                    teamMemberId  : member.matterTeamMember,
                    matterAdminId : member.matterAdmin
            ]
            return mem
        }
    } else {
        return []
    }
}

json g.render(project, [excludes: ['tasks', 'deletedMirror']]) {
    creator g.render(project.creator)
    closer g.render(project.closer)
    privateWorkstreamTeam renderPrivateWorkstreamTeam(project)
    taskCounts g.render(project.taskCounts)
}