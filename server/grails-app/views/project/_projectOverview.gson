import com.juralio.auth.AppUser
import com.juralio.project.ProjectOverview
import com.juralio.project.UserWithTaskCount
import server.PrivateWorkstreamMember

model {
    ProjectOverview projectOverview
}

def renderPeople(List<UserWithTaskCount> people) {
    people.collect {
        [id              : it.user.id,
         username        : it.user.username,
         firstname       : it.user.firstname,
         lastname        : it.user.lastname,
         enabled         : it.user.enabled, // This field is required for Userlist control
         taskCount       : it.taskCount,
         avatarColorIndex: it.user.avatarColorIndex,
         avatarImageIndex: it.user.avatarImageIndex
        ]
    }
}

def renderPrivateTeam(List<PrivateWorkstreamMember> members = []) {
    return members.collect {
        AppUser user = it.user
        return [id              : user.id,
                username        : user.username,
                firstname       : user.firstname,
                lastname        : user.lastname,
                enabled         : user.enabled,
                avatarColorIndex: user.avatarColorIndex,
                avatarImageIndex: user.avatarImageIndex,
                isActiveOnMatter: it.matterTeamMember != null,
                isViewerOnMatter: it.matterViewer != null,
                teamMemberId    : it.matterTeamMember,
                matterViewerId  : it.matterViewer,
                matterAdminId   : it.matterAdmin
        ]
    }
}

json g.render(projectOverview, [excludes: ["people", 'privateWorkstreamTeam']]) {
    people renderPeople(projectOverview.people)
    privateWorkstreamTeam renderPrivateTeam(projectOverview.privateWorkstreamTeam)
}