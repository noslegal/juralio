import com.juralio.auth.AppUser
import com.juralio.project.Project
import com.juralio.task.Task
import com.juralio.task.TaskBlocker
import com.juralio.task.label.TaskLabel
import server.PrivateWorkstreamMember

/**
 * The purpose of this view is to render and project and its entire task hierarchy in a recursive manner.
 */
model {
    Project project
}

def renderLabels(List<TaskLabel> labels) {
    labels.collect {
        [
                name    : it.label.name,
                type    : it.label.type,
                modifier: it.modifier,
                id      : it.id,
                labelId : it.label.id
        ]

    }
}


def renderTasks(List<Task> tasks) {
    tasks.collect {
        [id                   : it.id,
         referenceNumber      : it.referenceNumber,
         projectId            : it.project.id,
         name                 : it.name,
         status               : it.status,
         level                : it.level,
         plannedStartDate     : it.plannedStartDate,
         plannedEndDate       : it.plannedEndDate,
         isMilestone          : it.isMilestone,
         isDeliverable        : it.isDeliverable,
         lastUpdated          : it.lastUpdated,
         actualStartDate      : it.actualStartDate,
         actualEndDate        : it.actualEndDate,
         labels               : renderLabels(it.labels as List<TaskLabel>),
         blockers             : it.blockers? renderBlockers(it.blockers):[] ,
         datesLinkedToSiblings: it.datesLinkedToSiblings,
         isBlocker            : it?.isBlocker ? it.isBlocker : false,
         isBlocked            : it?.isBlocked ? it.isBlocked : false,
         posts                : it.posts,
         tasks                : renderTasks(it.tasks),
         description          : it.description,
         childCount           : it.tasks.size(),
         teamMembers          : it.teamMembers ? it.teamMembers.collect { taskMember ->
             [id              : taskMember.user ? taskMember.user.id : taskMember.placeholder.id,
              firstname       : taskMember.user ? taskMember.user.firstname : taskMember.placeholder.firstName,
              lastname        : taskMember.user ? taskMember.user.lastname : taskMember.placeholder.lastName,
              avatarColorIndex: taskMember.user ? taskMember.user.avatarColorIndex : '',
              avatarImageIndex: taskMember.user ? taskMember.user.avatarImageIndex : '',
              email           : taskMember.user ? taskMember.user.username : taskMember.placeholder.emailAddress,
              enabled         : taskMember.user ? taskMember.user.enabled : taskMember.placeholder.enabled,
              isExternal      : taskMember.user ? taskMember.user.externalUser != null : false,
              isOnAllSubtasks : taskMember.user ? taskMember.user.isOnAllSubtasks : taskMember.placeholder.isOnAllSubtasks,
              isOnSomeSubtasks: taskMember.user ? taskMember.user.isOnSomeSubtasks : taskMember.placeholder.isOnSomeSubtasks,
              isPlaceholder   : taskMember.placeholder ? true : false,
              organisationGroup: taskMember.user ? renderOrganisationGroup(taskMember.user.organisationGroup) : null
           ]
         } : [],
         followers            : it.followers.collect { follower ->
             [id       : follower.user.id,
              firstname: follower.user.firstname,
              lastname : follower.user.lastname,
              email    : follower.user.username,
              enabled  : follower.user.enabled]
         }
        ]
    }.sort { a, b -> a.status <=> b.status }
}

def renderOrganisationGroup(OrganisationGroup orgGroup){
return orgGroup ? [id:orgGroup.id,name:orgGroup.name] : null
}


def renderPosts(List<Task> tasks) {
    def posts = []
    tasks.each { Task t ->
        if (t.tasks) {
            posts.push(renderPosts(t.tasks))
        }
        if (t.posts) {
            posts.push(t.posts)
        }
    }
    return posts.flatten()
}

def renderPrivateTeam(List<PrivateWorkstreamMember> members = []) {
    return members.collect {
        AppUser user = it.user
        return [id              : user.id,
                username        : user.username,
                firstname       : user.firstname,
                lastname        : user.lastname,
                enabled         : user.enabled,
                avatarColorIndex: user.avatarColorIndex,
                avatarImageIndex: user.avatarImageIndex,
                isActiveOnMatter: it.matterTeamMember != null,
                isViewerOnMatter: it.matterViewer != null,
                teamMemberId    : it.matterTeamMember,
                matterViewerId  : it.matterViewer,
                matterAdminId   : it.matterAdmin
        ]
    }
}

def renderBlockers(List<TaskBlocker> blockers){
    return blockers.collect{[
            id:  it.id,
            blocker: [id: it.blocker.id, name:it.blocker.name, level:it.blocker.level,status:it.blocker.status],
            blocked: [id: it.blocked.id, name:it.blocked.name, level:it.blocked.level,status:it.blocked.status],
            relationship: it.relationship
    ]}

}

json g.render(project, [excludes: ['tasks', 'privateWorkstreamTeam']]) {
    taskCounts g.render(project.taskCounts)
    tasks renderTasks(project.levelATasks)
    privateWorkstreamTeam renderPrivateTeam(project.privateWorkstreamTeam)
    posts renderPosts(project.levelATasks)
    postCount project.postCount
}
