import com.juralio.matter.MatterTeamMember

model {
    MatterTeamMember matterTeamMember
}

json g.render(matterTeamMember,[includes: ['id'], excludes: ["user"]]) {
    user tmpl.'/appUser/appUser'(appUser: matterTeamMember.user)
    if (matterTeamMember.user.organisationGroup) {
        organisationGroup {
            id matterTeamMember.user.organisationGroup.id
            name matterTeamMember.user.organisationGroup.name
            isInternal matterTeamMember.user.organisationGroup.isInternal
            customLogo matterTeamMember.user.organisationGroup.logo != null
            organisationId matterTeamMember.user.organisationGroup.organisation?.id
        }
    }
}