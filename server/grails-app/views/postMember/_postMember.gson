import com.juralio.auth.AppUser
import com.juralio.matter.Placeholders
import com.juralio.post.members.PostMember

model {
    PostMember postMember
}

def renderUser(AppUser user) {
    if (user) {
          return  user.collect{[
                  id              : user.id,
                  isPlaceholder   : user.isPlaceholder,
                  firstname       : user.firstname,
                  lastname        : user.lastname,
                  username        : user.username,
                  enabled         : user.enabled,
                  isExternal      : user.externalUser,
                  avatarColorIndex: user.avatarColorIndex,
                  avatarImageIndex: user.avatarImageIndex,
                  isActiveOnMatter: user.isActiveOnMatter
          ]
        }
    }
    return []
}

def renderPlaceholder(Placeholders placeholder) {
    if (placeholder) {
            return placeholder.collect{[
                    id              : placeholder.id,
                    isPlaceholder   : true,
                    firstname       : placeholder.firstName,
                    lastname        : placeholder.lastName,
                    username        : placeholder.emailAddress,
                    enabled         : placeholder.enabled,
                    isExternal      : false,
                    avatarColorIndex: '',
                    avatarImageIndex: '',
                    isActiveOnMatter: true
            ]}
        }
    return []
}

json g.render(postMember,[excludes: ['user','placeholder']]) {
    id postMember.user ? postMember.user.id :postMember.placeholder.id
    user renderUser(postMember.user)
    placeholder renderPlaceholder(postMember.placeholder)
    isPlaceholder postMember.isPlaceholder
}