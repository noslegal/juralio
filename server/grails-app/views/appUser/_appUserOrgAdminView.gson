import com.juralio.auth.dto.AppUserDTO

model {
    AppUserDTO appUserDTO
}

json {
    id appUserDTO.user.id
    username appUserDTO.user.username
    firstname appUserDTO.user.firstname
    lastname appUserDTO.user.lastname
    enabled appUserDTO.user.enabled
    mfaEnabled appUserDTO.user.mfaEnabled
    roles appUserDTO.user.roles
    isActiveOnMatter appUserDTO.user.isActiveOnMatter
    temporaryPassword appUserDTO.user.temporaryPassword
    isThirdPartyUser appUserDTO.user.isThirdPartyUser
    thirdPartyProvider appUserDTO.user.thirdPartyProvider
    isExternal appUserDTO.user.externalUser != null
    organisation appUserDTO.user.organisation ? [id: appUserDTO.user.organisation.id.toString()] : null
    organisationGroup appUserDTO.user.organisationGroup ? [id: appUserDTO.user.organisationGroup.id.toString(), name: appUserDTO.user.organisationGroup.name, isInternal: appUserDTO.user.organisationGroup.isInternal] : null

    avatarColorIndex appUserDTO.user.avatarColorIndex
    avatarImageIndex appUserDTO.user.avatarImageIndex

    mostRecentActivityTime appUserDTO.mostRecentActivityTime
    onlineNow appUserDTO.onlineNow
    confirmationStatus appUserDTO.user.confirmationStatus
    trialStartDate appUserDTO.user.trialStartDate
    confirmationDate appUserDTO.user.confirmationDate
    lapsedDate appUserDTO.user.lapsedDate

    hasNeverSignedIn appUserDTO.user.hasNeverSignedIn
}