import com.juralio.auth.AppUser

model {
    AppUser appUser
}

json g.render(appUser, [includes: ['id', 'username', 'firstname', 'lastname', 'enabled', 'mfaEnabled', 'avatarColorIndex', 'avatarImageIndex','confirmationStatus','trialStartDate', 'organisationGroup']]) {
    roles appUser.roles
    isActiveOnMatter appUser.isActiveOnMatter
    temporaryPassword appUser.temporaryPassword
    isThirdPartyUser appUser.isThirdPartyUser
    thirdPartyProvider appUser.thirdPartyProvider
    isExternal appUser.externalUser != null
    organisation appUser.organisation ? [id: appUser.organisation.id.toString(), name: appUser.organisation.name] : null
    organisationGroup appUser.organisationGroup ? [id: appUser.organisationGroup.id.toString(), name: appUser.organisationGroup.name, isInternal: appUser.organisationGroup.isInternal] : null
    confirmationDate appUser.confirmationDate
    lapsedDate appUser.lapsedDate
    hasNeverSignedIn appUser.hasNeverSignedIn
}
