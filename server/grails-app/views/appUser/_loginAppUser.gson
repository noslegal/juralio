import com.juralio.auth.AppUser


model {
    AppUser appUser
}

def renderOrganisationGroup(OrganisationGroup orgGroup){
    return [
        id:orgGroup.id,
        name:orgGroup.name,
        position:orgGroup.groupPosition.name,
        isInternal:orgGroup.isInternal
        ]
}

json g.render(appUser, [includes: ['id', 'username', 'firstname', 'lastname', 'enabled', 'isThirdPartyUser', 'avatarColorIndex', 'avatarImageIndex', 'isExternal', 'isFirstLogin', 'needsToConfigureBilling', 'trialStartDate', 'confirmationStatus','isEarlyAccessOrg']]) {
    firstTimeUserExperience g.render(appUser.firstTimeUserExperience, [excludes: ['id']])
    roles appUser.roles
    isActiveOnMatter appUser.isActiveOnMatter
    sessionTimeout appUser.sessionTimeout
    isThirdPartyUser appUser.isThirdPartyUser
    isExternal appUser.externalUser != null
    isFirstLogin appUser.isFirstLogin
    needsToConfigureBilling appUser.needsToConfigureBilling
    trialStartDate appUser.trialStartDate
    confirmationStatus appUser.confirmationStatus
    isEarlyAccessOrg appUser.isEarlyAccessOrg
    organisationId appUser.organisation ?appUser.organisation.id :null
    organisationGroup appUser.organisationGroup ? renderOrganisationGroup(appUser.organisationGroup) : null
}