import com.juralio.auth.AppUser
import com.juralio.matterevent.MatterEvent
import com.juralio.usernotification.UserNotification
import groovy.json.JsonBuilder
import groovy.json.JsonSlurper

model {
    UserNotification userNotification
}

json {
    id userNotification.id
    read userNotification.read
    dismissed userNotification.dismissed
    dateCreated userNotification.dateCreated
    matterEvent buildMatterEvent(userNotification.matterEvent)
}

def buildMatterEvent(MatterEvent event) {
    return [
        id              : event.id,
        eventType       : event.eventType,
        schemaVersion   : event.schemaVersion,
        occurredAt      : event.occurredAt,
        matterId        : event.matter?.id,
        matterReference : event.matter?.caseId,
        matterName      : event.matter?.name,
        performedBy     : userSummary(event.performedBy),
        payload         : parsePayload(event.payload)
    ]
}

def userSummary(AppUser user) {
    return user ? [
        id              : user.id,
        firstName       : user.firstname,
        lastName        : user.lastname,
        avatarColorIndex: user.avatarColorIndex,
        avatarImageIndex: user.avatarImageIndex,
        isExternal      : user.externalUser != null
    ] : null
}

def parsePayload(String json) {
    if (!json) return null
    return new JsonBuilder(new JsonSlurper().parseText(json)).content
}
