  "scripts": {
    "start": "cross-env NODE_OPTIONS='--max-http-header-size=100000' vite",
    "start-https": "cross-env NODE_OPTIONS='--max-http-header-size=100000' SSL_CRT_FILE=./certs/localhost.pem SSL_KEY_FILE=./certs/localhost-key.pem vite",
    "build": "cross-env NODE_OPTIONS='--max-old-space-size=4096' vite build",
    "build:analyze": "cross-env ANALYZE=true NODE_OPTIONS='--max-old-space-size=4096' vite build",
    "pretty": "prettier --single-quote --trailing-comma es5 --no-semi --single-quote --write",
    "test": "jest",
    "test:ci": "cross-env CI=true jest --testResultsProcessor ./node_modules/jest-junit-reporter",
    "npm-check": "npm outdated --omit=dev",
    "lint": "eslint src",
    "lint:fix": "npm run lint -- --fix",
    "lint-staged": "lint-staged",
    "sort-json": "sort-json public/locales/en.json",
    "debug": "BROWSER='google chrome' BROWSER_ARGS='--remote-debugging-port=9222' vite"
  },
  "lint-staged": {
    "*.js": [
      "npm run pretty --",
      "eslint --quiet --fix"
    ]
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@vitejs/plugin-react": "^5.1.4",
    "babel-jest": "^30.4.1",
    "cross-env": "10.1.0",
    "css-mediaquery": "0.1.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-tss-unused-classes": "^1.0.4",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-junit-reporter": "1.1.0",
    "lint-staged": "16.4.0",
    "mockdate": "3.0.5",
    "node-notifier": "^10.0.1",
    "prettier": "3.8.4",
    "query-string": "^8.1.0",
    "redux-devtools-extension": "2.13.9",
    "redux-mock-store": "1.5.5",
    "rollup-plugin-visualizer": "^5.12.0",
    "shx": "0.4.0",
    "sort-json": "2.0.1",
    "vite": "^7.3.1",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-svgr": "^4.5.0"
  },
  "browserslist": {
    "production": [
      ">1.3%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "transform": {
      ".+\\.[t|j]sx?$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!@d3-hierarchy|d3-array|d3-selection|d3-selection|d3-scale|d3-hierarchy|d3-color|d3-shape|d3-zoom|d3-path|d3-drag|d3-transition|d3-dispatch|d3-ease|internmap|d3-timer|d3-format|d3-time|d3-interpolate|query-string)"
    ],
    "moduleNameMapper": {
      "\\.(svg|png|jpg|jpeg|gif|webp|ico)$": "<rootDir>/src/__mocks__/fileMock.js",
      "\\.(css)$": "<rootDir>/src/__mocks__/styleMock.js"
    }
  }
}
