# Copy to .env.local to enable Google integrations locally:
#
#     cp .env.local.example .env.local
#
# VITE_GOOGLE_API_CLIENT_ID powers "Sign in with Google" on the login screen and
# the Google Drive file picker; the remaining keys are only needed by the picker.
# The app runs fine without this file — the Google sign-in button and picker will
# simply not work. The real development values are not in the repository; ask
# another developer for them.
VITE_GOOGLE_API_CLIENT_ID=
VITE_GOOGLE_API_APP_ID=
VITE_GOOGLE_API_SCOPE=https://www.googleapis.com/auth/drive.readonly
VITE_GOOGLE_API_DEVELOPER_KEY=
